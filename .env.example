# ==================== 数据库配置 ====================
# Backend MySQL（独立数据库）- 必需配置
# 设置强密码，生产环境必须修改这些默认值
BACKEND_MYSQL_ROOT_PASSWORD=<your-mysql-root-password>
BACKEND_MYSQL_DATABASE=genio_backend_db
BACKEND_MYSQL_USER=genio_backend_user
BACKEND_MYSQL_PASSWORD=<your-mysql-password>

# Backend Redis（独立实例）- 必需配置
BACKEND_REDIS_PASSWORD=<your-redis-password>

# ==================== LLM 服务配置 ====================
# 根据你的 conf/server.yaml，以下是你已有的配置
# 可以直接从 server.yaml 复制，或在这里配置后在 server.prod.yaml 中引用

# Azure OpenAI - 从 server.yaml 复制
AZURE_OPENAI_ENDPOINT=https://dmdsp-openai-us2.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>

# 豆包（字节跳动）- 从 server.yaml 复制
DOUBAO_API_KEY=<your-doubao-api-key>
DOUBAO_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_REGION=cn-beijing
DOUBAO_PRO_MODEL=ep-20250214171140-jhq27
DOUBAO_PRO_VISION_MODEL=ep-20250214171032-hbc67

# DeepSeek - 从 server.yaml 复制
DEEPSEEK_API_KEY=<your-deepseek-api-key>

# ==================== 对象存储配置 ====================
# Cloudflare R2 - 从 server.yaml 复制
R2_ENDPOINT=https://08e5d61be623f63d785df35604e48655.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_ACCESS_KEY_SECRET=<your-r2-secret-access-key>
R2_BUCKET=genio-ai
R2_PUBLIC_URL=https://cdn.appbobo.com

# ==================== 邮件配置 ====================
# 从 server.yaml 复制
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USERNAME=624345999@qq.com
SMTP_PASSWORD=<your-smtp-app-password>
SMTP_FROM=624345999@qq.com

# ==================== 其他配置（可选）====================
# Apple Sign In - 从 server.yaml 复制
APPLE_TEAM_ID=J392M2H9CQ
APPLE_KID=3FV4897G7Z
# Apple Private Key 已在 server.yaml 中配置，这里不需要重复

# ==================== 生产环境建议 ====================
# 1. 数据库密码必须修改为强密码
# 2. 敏感 API Key 建议使用密钥管理服务
# 3. 此文件不要提交到 Git（已在 .gitignore 中）
